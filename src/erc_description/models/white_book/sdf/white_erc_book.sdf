<?xml version="1.0"?>
<sdf version="1.8">
  <model name="white_erc_book">
    <link name="book_base_link">
    
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.000662500</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002202500</iyy>
          <iyz>0</iyz>
          <izz>0.001585000</izz>
        </inertia>
      </inertial>

      <visual name="base_link_book_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.03 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
        </material>
      </visual>

      <!-- Cover image on the +Y face (visual only) -->
      <visual name="cover_visual">
        <pose>0 0.016 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.001 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://erc_description/models/white_book/textures/BOOK_PLACEHOLDER.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Spine image on the -Z face, facing the robot (visual only) -->
      <visual name="spine_visual">
        <pose>0 0 -0.081 0 0 0</pose>
        <geometry>
          <box>
            <size>0.25 0.03 0.001</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://erc_description/models/white_book/textures/BOOK_SPINE_PLACEHOLDER.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <!-- Cover image on the -Y face (visual only) -->
      <visual name="cover_back_visual">
        <pose>0 -0.016 0 0 3.14159 0</pose>
        <geometry>
          <box>
            <size>0.25 0.001 0.16</size>
          </box>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr>
            <metal>
              <albedo_map>model://erc_description/models/white_book/textures/BOOK_PLACEHOLDER.png</albedo_map>
              <roughness>1.0</roughness>
              <metalness>0.0</metalness>
            </metal>
          </pbr>
        </material>
      </visual>

      <collision name="base_link_book_collision">
        <pose>0 0 0 0 0 0</pose>
        <max_contacts>4</max_contacts>

        <geometry>
          <box>
            <size>0.25 0.03 0.16</size>
          </box>
        </geometry>
        <!-- Explicit friction so books sit on the shelf without sliding and the
             gripper can hold them. Was previously inheriting the world default. -->
        <surface>
          <friction>
            <ode>
              <mu>10.0</mu>
              <mu2>10.0</mu2>
            </ode>
          </friction>
          <contact>
            <ode>
              <!-- Softer contact than a rigid default reduces solver stress and
                   jitter for many resting books; tune if grasps feel spongy. -->
              <kp>100000.0</kp>
              <kd>1.0</kd>
            </ode>
          </contact>
        </surface>
      </collision>

    </link>
  </model>
</sdf>
